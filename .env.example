# Copy to .env.local (git-ignored) or set these in your terminal session.
# One pair per user type in run.config.json; the suffix is the user type key in UPPER_CASE.
# Get them from DevTools > Application > Cookies after logging in as that user.
# Delete .env.local after the run; tokens are live credentials.

AMP_JWT_SITE_ADMIN=
AMP_CSRF_SITE_ADMIN=

AMP_JWT_CHANNEL_MANAGER=
AMP_CSRF_CHANNEL_MANAGER=

AMP_JWT_CORPORATE_PRM_ADMIN=
AMP_CSRF_CORPORATE_PRM_ADMIN=

AMP_JWT_PARTNER_SALES=
AMP_CSRF_PARTNER_SALES=
