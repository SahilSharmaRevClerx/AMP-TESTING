# Copy to .env.local (git-ignored) or set these in your terminal session.
# One jwt per user type in run.config.json; the suffix is the user type key in UPPER_CASE.
# Copy the jwt cookie from DevTools > Application > Cookies after logging in as that user (AMP_CSRF_<TYPE> is optional; the tool generates one).
# Delete .env.local after the run; tokens are live credentials.

AMP_JWT_SITE_ADMIN=

AMP_JWT_CHANNEL_MANAGER=

AMP_JWT_CORPORATE_PRM_ADMIN=

AMP_JWT_PARTNER_SALES=

# Permission Setter AI review (optional): Google Gemini API key, and optionally the model (default gemini-2.5-pro).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
