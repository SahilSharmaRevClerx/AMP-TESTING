{
  "name": "amp-permission-testing",
  "version": "0.1.0",
  "private": true,
  "description": "Checks AMP page visibility per user type against an expected-access rulebook, with screenshot evidence.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/app/server.ts",
    "start:debug": "tsx src/app/server.ts --debug",
    "check": "tsx src/cli.ts check",
    "menu": "tsx src/cli.ts menu",
    "run": "tsx src/cli.ts run",
    "mcp": "tsx src/cli.ts mcp",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "tsx tests/e2e/run-e2e.ts",
    "e2e:ui": "tsx tests/e2e/ui-e2e.ts",
    "e2e:mcp": "tsx tests/e2e/mcp-ui-e2e.ts",
    "e2e:mcp-run": "tsx tests/e2e/mcp-run-e2e.ts",
    "e2e:mcp-ai": "tsx tests/e2e/mcp-ai-e2e.ts",
    "e2e:setter": "tsx tests/e2e/setter-e2e.ts",
    "e2e:handoff": "tsx tests/e2e/handoff-e2e.ts",
    "e2e:browser-start": "tsx tests/e2e/browser-start-e2e.ts"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "exceljs": "^4.4.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
